(in-package #:diff-protocol/tests)

;;; R1 :UNIFIED for text diffs: bare hunks, no file headers. Headers are 1-based;
;;; a count of 1 is omitted; for a count of 0 the start is the line before.

(defparameter *no-eol-marker* "\\ No newline at end of file")

(deftest-parametrize unified-render-text
    ((a b keys expected)
     :ids ("modify" "insert" "delete" "two-hunks" "no-eol-both" "add-eol" "remove-eol"
           "from-empty" "to-empty" "crlf" "context" "merged-context" "identical")
     ((nl "a" "b" "c") (nl "a" "B" "c") '()
      (nl "@@ -2 +2 @@" "-b" "+B"))
     ((nl "a" "c") (nl "a" "b" "c") '()
      (nl "@@ -1,0 +2 @@" "+b"))
     ((nl "a" "b" "c") (nl "a" "c") '()
      (nl "@@ -2 +1,0 @@" "-b"))
     ((nl "a" "b" "c" "d" "e") (nl "A" "b" "c" "d" "E" "F") '()
      (nl "@@ -1 +1 @@" "-a" "+A" "@@ -5 +5,2 @@" "-e" "+E" "+F"))
     ((cat (nl "a") "b") (cat (nl "a") "B") '()
      (nl "@@ -2 +2 @@" "-b" *no-eol-marker* "+B" *no-eol-marker*))
     ("a" (nl "a") '()
      (nl "@@ -1 +1 @@" "-a" *no-eol-marker* "+a"))
     ((nl "a") "a" '()
      (nl "@@ -1 +1 @@" "-a" "+a" *no-eol-marker*))
     ("" (nl "x") '()
      (nl "@@ -0,0 +1 @@" "+x"))
     ((nl "x" "y") "" '()
      (nl "@@ -1,2 +0,0 @@" "-x" "-y"))
     ((crlf "a") (crlf "b") '()
      (cat (nl "@@ -1 +1 @@") (crlf "-a" "+b")))
     ((nl "1" "2" "3" "4" "5") (nl "1" "2" "X" "4" "5") '(:context 1)
      (nl "@@ -2,3 +2,3 @@" " 2" "-3" "+X" " 4"))
     ((nl "1" "2" "3" "4" "5" "6") (nl "1" "B" "3" "D" "5" "6") '(:context 1)
      (nl "@@ -1,5 +1,5 @@" " 1" "-2" "+B" " 3" "-4" "+D" " 5"))
     ((nl "a") (nl "a") '() ""))
  (let ((diff (apply #'d:compute-diff *text* a b keys)))
    (ok (equal expected (d:render-diff diff :unified nil)))
    (ok (equal expected (with-output-to-string (s) (d:render-diff diff :unified s))) "to a stream")))

(deftest unified-render-levels-and-inverse
  (let* ((a (nl "a" "b" "c" "d" "e"))
         (b (nl "A" "b" "c" "d" "E" "F"))
         (expected (nl "@@ -1 +1 @@" "-a" "+A" "@@ -5 +5,2 @@" "-e" "+E" "+F")))
    (ok (equal expected (d:render-diff (d:compute-diff *text* a b :level :content) :unified nil))
        ":content renders its hunks")
    (ok (equal expected (d:render-diff (d:compute-diff *text* a b :level :summary) :unified nil))
        ":summary root is diffed (context 0) to render")
    (ok (equal (nl "@@ -1 +1 @@" "-A" "+a" "@@ -5,2 +5 @@" "-E" "-F" "+e")
               (d:render-diff (d:invert-diff (d:compute-diff *text* a b)) :unified nil))
        "an inverted (ascending) diff renders in its own coordinates")))

(deftest unified-render-unsupported
  (ok (signals (d:render-diff (diff-of '(:a 1) '(:a 2)) :unified nil) 'd:unsupported-content)
      "sexp diffs have no unified form")
  (let* ((d1 (d:compute-diff *text* (nl "a" "b") (nl "A" "b")))
         (d2 (d:compute-diff *text* (nl "A" "b") (nl "A" "b" "c" "d")))
         (d3 (d:compute-diff *text* (nl "A" "b" "c" "d") (nl "x" "b" "c" "d"))))
    (ok (signals (d:render-diff (d:compose-diffs (d:compose-diffs d1 d2) d3) :unified nil)
                 'd:unsupported-content)
        "hunks neither descending nor ascending")))

(deftest unified-render-summary-format
  (ok (equal (format nil "M text:/1-2~%")
             (d:render-diff (d:compute-diff *text* (nl "a" "b" "c") (nl "a" "B" "c")) :summary nil))))

(deftest-parametrize unified-parse-text
    ((input expected)
     :ids ("modify" "insert" "context-kept" "no-eol" "two-hunks-descending" "explicit-count-1")
     ((nl "@@ -2 +2 @@" "-b" "+B")
      (list (list :modify '(1) (list (nl "b")) (list (nl "B")) (list (text-fp 1 2)))))
     ((nl "@@ -1,0 +2 @@" "+b")
      (list (list :add '(1) nil (list (nl "b")) (list (text-fp 1 1)))))
     ((nl "@@ -2,3 +2,3 @@" " 2" "-3" "+X" " 4")
      (list (list :modify '(1) (list (nl "2") (nl "3") (nl "4")) (list (nl "2") (nl "X") (nl "4"))
                  (list (text-fp 1 4)))))
     ((nl "@@ -2 +2 @@" "-b" *no-eol-marker* "+B")
      (list (list :modify '(1) (list "b") (list (nl "B")) (list (text-fp 1 2)))))
     ((nl "@@ -1 +1 @@" "-a" "+A" "@@ -5 +5,2 @@" "-e" "+E" "+F")
      (list (list :modify '(4) (list (nl "e")) (list (nl "E") (nl "F")) (list (text-fp 4 5)))
            (list :modify '(0) (list (nl "a")) (list (nl "A")) (list (text-fp 0 1)))))
     ((nl "@@ -3,1 +3,1 @@" "-c" "+C")
      (list (list :modify '(2) (list (nl "c")) (list (nl "C")) (list (text-fp 2 3))))))
  (let ((diff (d:parse-diff :unified input)))
    (ok (typep (d:diff-engine diff) 'd:text-diff-engine) "bare hunks → a text diff")
    (ok (eq :changes (d:diff-level diff)))
    (ok (equal expected (shapes diff)))
    (ok (equal expected (shapes (with-input-from-string (s input) (d:parse-diff :unified s))))
        "from a stream")))

(deftest unified-parse-empty
  (let ((diff (d:parse-diff :unified "")))
    (ok (typep diff 'd:diff))
    (ok (d:diff-empty-p diff))))

(deftest-parametrize unified-parse-errors
    ((input line)
     :ids ("bad-header" "short-body" "bad-line-prefix" "stray-no-eol")
     ((nl "@@ garbage" "-a") 1)
     ((nl "@@ -1,2 +1,2 @@" "-a" "+b") 4)
     ((nl "@@ -1 +1 @@" "*a" "+b") 2)
     ((nl "@@ -1 +1 @@" *no-eol-marker* "-a" "+b") 2))
  (let ((c (handler-case (progn (d:parse-diff :unified input) nil)
             (d:diff-parse-error (e) e))))
    (ok (typep c 'd:diff-parse-error))
    (ok (typep c 'd:diff-error))
    (ok (eql line (and c (d:diff-parse-error-line c))) "1-based line of the error")))

(deftest-parametrize unified-text-round-trip
    ((engine a b level) :ids (text-pair-ids :engines '(*text*) :levels '(:changes))
                        :rows (text-pair-rows :engines '(*text*) :levels '(:changes)))
  (let* ((diff (d:compute-diff engine a b :level level))
         (text (d:render-diff diff :unified nil))
         (parsed (d:parse-diff :unified text)))
    (ok (equal text (d:render-diff parsed :unified nil)) "render → parse → render is string=")
    (ok (equal (shapes diff) (shapes parsed)) "same hunks")
    (ok (tx= b (d:apply-diff a parsed)))))

(deftest-parametrize unified-text-context-round-trip
    ((engine a b level) :ids (text-pair-ids :engines '(*text*) :levels '(:changes))
                        :rows (text-pair-rows :engines '(*text*) :levels '(:changes)))
  (let* ((diff (d:compute-diff engine a b :level level :context 3))
         (text (d:render-diff diff :unified nil))
         (parsed (d:parse-diff :unified text)))
    (ok (equal text (d:render-diff parsed :unified nil)))
    (ok (tx= b (d:apply-diff a parsed)) "parsed context hunks apply")
    (ok (tx= a (d:apply-diff b (d:invert-diff parsed))))))
